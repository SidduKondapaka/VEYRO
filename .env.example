# ============================================================
# VEYRO Marketplace - Environment Configuration Sample
# ============================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=veyro_db
DB_USERNAME=veyro
DB_PASSWORD=Veyro@2026!

# Spring Boot Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security Configuration
# Must be a secure 256-bit (32-character or longer) secret key for HMAC-SHA256
JWT_SECRET=veyroSecureMarketplaceSuperSecretKey2026MustBeAtLeast256BitsLong!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
